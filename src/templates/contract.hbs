<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8"/>
<title>{{title}}</title>
<style>{{{_styles}}}</style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="title">{{title}}</div>
      <div class="subtitle">{{clientName}} • {{date}}</div>
    </div>

    <div class="card">
      {{{body_html}}}
    </div>

    <div class="card">
      <div class="section-title">Signatures</div>
      <div style="display:flex; gap:40px; margin-top:18px">
        <div style="flex:1">
          <div style="height:60px;border-bottom:1px solid #444"></div>
          <div style="color:var(--text-gray);font-size:12px">Provider</div>
        </div>
        <div style="flex:1">
          <div style="height:60px;border-bottom:1px solid #444"></div>
          <div style="color:var(--text-gray);font-size:12px">Client</div>
        </div>
      </div>
    </div>

    <div class="footer">AI Dealt • Confidential</div>
  </div>
</body>
</html>
