<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8"/>
<title>{{title}}</title>
<style>{{{_styles}}}</style>
</head>
<body>
  <div class="container">
    <div class="header">
      <div class="title">Call Summary</div>
      <div class="subtitle">{{clientName}} • {{date}}</div>
    </div>

    <div class="card">
      <div class="section-title">Transcript</div>
      <div>{{{transcript}}}</div>
    </div>

    <div class="card">
      <div class="section-title">Detected Actions & Insights</div>
      <ul>
        {{#each insights}}
          <li>{{this}}</li>
        {{/each}}
      </ul>
    </div>

    <div class="card">
      <div class="section-title">Next Steps</div>
      <ol>
        {{#each nextSteps}}
          <li>{{this}}</li>
        {{/each}}
      </ol>
    </div>

    <div class="footer">AI Dealt • Generated at {{generatedAt}}</div>
  </div>
</body>
</html>
